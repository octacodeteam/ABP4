# Porta do backend Express
PORT=3001

# Banco PostgreSQL local. No pgAdmin, crie o banco medcare_iot e use a senha 123 no usuário postgres.
DATABASE_URL="postgresql://postgres:123@localhost:5432/medcare_iot?schema=public"

# Segredo usado para assinar os tokens de login do app.
TOKEN_SECRET="troque-este-segredo-em-producao"

# Token simples usado pelo ESP32 para conversar com o backend.
# No idea.ino, use o mesmo valor em DEVICE_TOKEN.
DEFAULT_DEVICE_TOKEN="123"

MQTT_BROKER_URL="mqtt://broker.hivemq.com:1883"
MQTT_TOPIC_PREFIX="medcare/abp4/grupo01"
