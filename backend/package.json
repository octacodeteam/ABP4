{
  "name": "medcare-iot-backend",
  "version": "2.0.0",
  "description": "Backend Express + PostgreSQL/Prisma para dispenser inteligente de remédios",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init_medcare_iot",
    "prisma:studio": "prisma studio",
    "db:push": "prisma db push"
  },
  "keywords": [
    "iot",
    "medicamentos",
    "dispensador",
    "express",
    "typescript",
    "postgresql",
    "prisma"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mqtt": "^5.15.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "prisma": "^6.19.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.2"
  }
}
